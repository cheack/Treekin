<?xml version="1.0" encoding="utf-8"?>
<!-- Treekin card: soft tint plus a 4dp stripe on the start edge (own look, not Geni's) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="?attr/geni_cardFemale" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:width="4dp" android:gravity="start">
        <shape>
            <solid android:color="@color/female" />
            <corners
                android:bottomLeftRadius="4dp"
                android:topLeftRadius="4dp" />
        </shape>
    </item>
</layer-list>
