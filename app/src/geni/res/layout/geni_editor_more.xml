<?xml version="1.0" encoding="utf-8"?>
<!-- Fields of the person editor for a Geni tree, bound by GeniProfileEditor -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/editor_burialDateLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/geni_burial_date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editor_burialDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapCharacters" />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageView
            android:id="@+id/editor_burialAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/invalid_date"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/editor_burialDateLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/editor_burialDateLabel"
            app:srcCompat="@drawable/alert" />

        <app.familygem.DateEditorLayout
            android:id="@+id/editor_burialDateEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/editor_burialDateLabel" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/editor_burialPlaceLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/geni_burial_place"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/editor_burialDateEditor">

            <app.familygem.PlaceFinderTextView
                android:id="@+id/editor_burialPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/editor_occupationLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/occupation">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editor_occupation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:imeOptions="actionNext" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/editor_aboutLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/geni_about_me">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editor_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3"
            android:gravity="top" />
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/editor_geniPublic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/geni_public_profile" />
    <TextView
        android:id="@+id/editor_geniPublicNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/editor_emailLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/geni_new_email"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editor_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:id="@+id/editor_emailNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/geni_new_email_note"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />
    <TextView
        android:id="@+id/editor_lineageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="@string/lineage"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:visibility="gone" />
    <RadioGroup
        android:id="@+id/editor_lineageGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <RadioButton
            android:id="@+id/editor_lineageBirth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/birth" />
        <RadioButton
            android:id="@+id/editor_lineageAdopted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adopted" />
        <RadioButton
            android:id="@+id/editor_lineageFoster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/foster" />
    </RadioGroup>
    <TextView
        android:id="@+id/editor_lineageNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/geni_lineage_note"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />
</merge>
