<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the app manifest by the manifest merger: upstream AndroidManifest.xml stays untouched. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <activity
            android:name=".ui.GeniLoginActivity"
            android:exported="true"
            android:label="@string/geni_menu_account"
            android:launchMode="singleTask">
            <!-- OAuth redirect: scheme from geniRedirectUri in geni.properties -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${geniRedirectScheme}" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.GeniSyncBacklogActivity"
            android:exported="false"
            android:label="@string/geni_menu_sync_backlog" />
    </application>

</manifest>
